# Mindspace — Discovery configuration (all optional).
# Copy to .env.local and fill in what you need. Keys are read on the server only
# and are never sent to the browser. Never commit a real key.

# Without any key, Discovery already searches these free public indexes, chosen per topic:
#   OpenAlex, arXiv, Europe PMC (PubMed) · GDELT news · Hacker News, GitHub, Stack Overflow
#   Federal Register, World Bank documents · Wikipedia (one source among many)

# General web search — the broadest coverage (any website, official docs, news sites,
# government pages). Set ONE of these; strongly recommended.
BRAVE_SEARCH_API_KEY=        # https://api-dashboard.search.brave.com
TAVILY_API_KEY=              # https://app.tavily.com

# When both keys are set, pick one: brave (default) or tavily.
DISCOVERY_SEARCH_PROVIDER=

# Optional keys that raise the anonymous quotas of keyless providers.
OPENALEX_API_KEY=            # https://openalex.org/settings/api (keyless use shares a small daily budget per IP)
GITHUB_TOKEN=                # a token with no scopes is enough (10 → 30 searches/min)
STACKEXCHANGE_KEY=           # https://stackapps.com/apps/oauth/register (300 → 10,000 requests/day)

# Contact email sent to OpenAlex as `mailto` (its "polite pool").
DISCOVERY_CONTACT_EMAIL=

# Comma-separated provider ids to turn off, e.g. "gdelt,github".
# Ids: openalex, arxiv, europepmc, gdelt, hackernews, github, stackexchange, federalregister, worldbank, wikipedia
DISCOVERY_DISABLE_PROVIDERS=

# Set to 1 to turn off the keyless Wikipedia search (same as listing it above).
DISCOVERY_DISABLE_WIKIPEDIA=
